{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livingdesign.example/events/order-created.schema.json",
  "title": "order-created",
  "description": "Une commande vient d'être créée. Topic : livingdesign.orders, clé : order_id. Publié par le service orders (simulé par data-platform/streaming/producer.py tant que le service n'existe pas).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "order_id", "customer_id", "status", "total_cents", "items"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid", "description": "Identifiant unique de l'événement : permet aux consommateurs d'ignorer un doublon."},
    "event_type": {"const": "order-created"},
    "occurred_at": {"type": "string", "format": "date-time", "description": "Heure de l'événement (temps de l'événement, utilisé par les fenêtres Spark), en UTC."},
    "order_id": {"type": "integer", "minimum": 1},
    "customer_id": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PENDING", "PAID", "PAYMENT_FAILED"]},
    "total_cents": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "quantity", "unit_price_cents"],
        "properties": {
          "product_id": {"type": "integer", "minimum": 1},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price_cents": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
