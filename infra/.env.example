# Copie ce fichier en "infra/.env" (même dossier) puis change TOUTES les valeurs.
# .env contient des secrets : il est dans .gitignore et ne part jamais sur Git.

# ---- PostgreSQL : super-utilisateur, seulement pour l'initialisation ----
POSTGRES_USER=ld_admin
POSTGRES_PASSWORD=change-moi-admin
POSTGRES_DB=livingdesign
# Si PostgreSQL est déjà installé sur ton PC, le port 5432 est pris : mets 5433.
POSTGRES_PORT=5432

# ---- Un rôle PostgreSQL par microservice ----
ORDERS_DB_PASSWORD=change-moi-orders
INVENTORY_DB_PASSWORD=change-moi-inventory
PAYMENTS_DB_PASSWORD=change-moi-payments
AUTH_DB_PASSWORD=change-moi-auth
ANALYTICS_DB_PASSWORD=change-moi-analytics

# ---- MongoDB ----
MONGO_ROOT_USER=ld_mongo_admin
MONGO_ROOT_PASSWORD=change-moi-mongo
MONGO_DB=livingdesign
MONGO_PORT=27017
CATALOG_DB_PASSWORD=change-moi-catalog

# ---- Données fictives générées ----
SEED_CUSTOMERS=3000
SEED_ORDERS=20000
SEED_MONTHS=6

# ---- Temps réel (Kafka + Spark Streaming) ----
KAFKA_PORT=9094
ORDER_SPIKE_THRESHOLD=40
